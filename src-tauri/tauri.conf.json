{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "1.2.24",
  "identifier": "gg.nexus.chat",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-dist.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nexus",
        "width": 1280,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QTZEM0FGQjYyRTM3NEIKUldSTE55NjJyOU9tUkZoTFNtV0FVUG5wdzFFdjdwbkg2eWpna0R5RGZvWUg1OGhTdld5VDc3cFMK",
      "endpoints": [
        "https://github.com/SniderL06/nexus-gaming-chat/releases/latest/download/latest.json"
      ]
    }
  }
}

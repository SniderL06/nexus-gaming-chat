{
  "name": "nexus-gaming-chat",
  "productName": "Nexus",
  "version": "1.2.26",
  "description": "Nexus Gaming Chat Client",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build:windows": "electron-builder --windows nsis",
    "build:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "gg.nexus.chat",
    "productName": "Nexus",
    "directories": {
      "output": "release-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network;Chat;AudioVideo;",
      "icon": "assets/icons/icon-512.png"
    },
    "files": [
      "electron-main.js",
      "index.html",
      "privacy.html",
      "ad-banner.html",
      "manifest.json",
      "sw.js",
      "ads.js",
      "css/**/*",
      "js/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
